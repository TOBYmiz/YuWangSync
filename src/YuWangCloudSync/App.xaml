<Application
    x:Class="YuWangCloudSync.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Keep the SDK dictionary first; application styles below can then reference its resources. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Controls use the stock WinUI styles, including all interaction states.
                 Only application layout and semantic text emphasis are defined here. -->
            <Style x:Key="YuWangCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="YuWangCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12,16,14" />
            </Style>
            <!-- Main window navigation tree. TreeViewNode.Content is a plain string (as in the stock
                 TreeViewItemDataTemplate); MainWindow picks one of these fixed-icon templates per node kind. -->
            <DataTemplate x:Key="YuWangNavigationRootTemplate">
                <StackPanel Orientation="Horizontal" Spacing="10" ToolTipService.ToolTip="{Binding Content}">
                    <FontIcon Glyph="&#xE753;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="YuWangNavigationContainerTemplate">
                <StackPanel Orientation="Horizontal" Spacing="10" ToolTipService.ToolTip="{Binding Content}">
                    <FontIcon Glyph="&#xE8F1;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="YuWangNavigationDiskTemplate">
                <StackPanel Orientation="Horizontal" Spacing="10" ToolTipService.ToolTip="{Binding Content}">
                    <FontIcon Glyph="&#xEDA2;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="YuWangNavigationFolderTemplate">
                <StackPanel Orientation="Horizontal" Spacing="10" ToolTipService.ToolTip="{Binding Content}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="YuWangImageFrameStyle" TargetType="Border" BasedOn="{StaticResource YuWangCardStyle}">
                <Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
